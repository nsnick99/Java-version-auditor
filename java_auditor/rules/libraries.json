    {"groupId":"org.springframework.boot","artifactIds":["spring-boot","spring-boot-starter","spring-boot-autoconfigure"],"minSupportedMajor":3,"recommendedVersion":"3.3.x","note":"Spring Boot 3 requires Java 17+ and Jakarta EE 9+","jakarta":true},
    {"groupId":"org.hibernate","artifactIds":["hibernate-core"],"minSupportedMajor":6,"recommendedVersion":"6.4.x","note":"Hibernate 6 uses jakarta.persistence","jakarta":true},
    {"groupId":"com.fasterxml.jackson.core","artifactIds":["jackson-databind","jackson-core","jackson-annotations"],"minSupportedMajor":2,"minSupportedMinor":15,"recommendedVersion":"2.17.x","note":"Use a current supported Jackson 2.x release"},
    {"groupId":"org.apache.logging.log4j","artifactIds":["log4j-core","log4j-api"],"minSupportedMajor":2,"minSupportedMinor":17,"recommendedVersion":"2.23.x","note":"Use a current supported Log4j 2.x release"},
